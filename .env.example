# Genuinos UY — Environment Variables
# Copy this file to .env and fill in the values from your Supabase dashboard.

# Project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://wqrjusxmyklienzqlket.supabase.co

# Anon public key (Settings → API → Project API keys → anon public)
# Safe to expose in the browser — protected by RLS policies.
VITE_SUPABASE_ANON_KEY=

# Service role key (Settings → API → Project API keys → service_role secret)
# DO NOT expose to the browser. Only for Edge Functions / server scripts.
SUPABASE_SERVICE_ROLE_KEY=
